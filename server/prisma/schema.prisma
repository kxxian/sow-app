// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int    @id @default(autoincrement())
  businessName  String
  contactPerson String
  address       String
  postalNumber  String
  city          String
  email         String @unique
  phoneNumber   String
  password      String
}

model PriceList {
  id            Int    @id @default(autoincrement())
  articleNumber String
  product       String
  inPrice       Float
  price         Float
  unit          String
  inStock       Float
  description   String
}

model Language {
  id   Int    @id @default(autoincrement())
  lang String
}
